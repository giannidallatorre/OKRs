# General Settings
LOG=INFO
DATE_FROM=YYYY/MM
DATE_TO=YYYY/MM
SSL_CHECK=True

# Google Sheets Configuration
# Service Account Mode (choose one):
#   - SERVICE_ACCOUNT_JSON: GitHub Actions mode (full JSON string as environment variable)
#   - SERVICE_ACCOUNT_FILE: Local development mode (path to .config/service_account.json file)
# Precedence: SERVICE_ACCOUNT_JSON is checked first, then falls back to SERVICE_ACCOUNT_FILE
SERVICE_ACCOUNT_FILE=.config/service_account.json
# Name of the Spreadsheet
GOOGLE_SHEET_NAME=EGI_OKR_Reporting
# Worksheets Names
GOOGLE_CLOUD_WORKSHEET=Cloud
GOOGLE_HTC_WORKSHEET=HTC
GOOGLE_VOS_WORKSHEET=VOs
GOOGLE_VOS_REPORT_WORKSHEET=Report
GOOGLE_ORDERS_WORKSHEET=Orders
GOOGLE_SLAs_WORKSHEET=SLAs
GOOGLE_TEMPLATES_WORKSHEET=Templates

# SLA Specific Sheets (if different)
GOOGLE_SLAs_SHEET_NAME=EGI_SLAs
GOOGLE_SLAs_CLOUD_WORKSHEET=CloudReport
GOOGLE_SLAs_HTC_WORKSHEET=HTCReport
GOOGLE_OLAs_WORKSHEET=OLAs

# Jira Integration
JIRA_SERVER_URL=https://jira.egi.eu/
JIRA_AUTH_TOKEN=your_token_here
# Global project key (used as default for others)
JIRA_PROJECT=EOSC
# Optional specific overrides
SERVICE_ORDERS_PROJECTKEY=
SERVICE_ORDERS_ISSUETYPE="Service Order"
COMPLAINS_PROJECTKEY=
VIOLATIONS_PROJECTKEY=
ISSUETYPE="SLA Violation"

# Confluence Integration (authoritative SLA VO list)
# Generate a Personal Access Token at:
#   https://confluence.egi.eu/plugins/personalaccesstokens/usertokens.action
# The account must have read access to the IMS (Integrated Management System) space.
CONFLUENCE_SERVER_URL=https://confluence.egi.eu/
CONFLUENCE_AUTH_TOKEN=your_confluence_pat_here

# EGI Operations Portal
OPERATIONS_SERVER_URL=https://operations-portal.egi.eu/api
OPERATIONS_API_KEY=your_api_key_here
OPERATIONS_FORMAT=json
OPERATIONS_VO_LIST_PREFIX=vo-list
OPERATIONS_VO_ID_CARD_PREFIX=vo-id-card
OPERATIONS_VOS_REPORT_PREFIX=vo-report

# EGI Accounting Portal
ACCOUNTING_SERVER_URL=https://accounting.egi.eu
ACCOUNTING_SCOPE=cloud
ACCOUNTING_METRIC=cpu
ACCOUNTING_LOCAL_JOB_SELECTOR=only-local-jobs
ACCOUNTING_VO_GROUP_SELECTOR=vo-group
ACCOUNTING_DATA_SELECTOR=data
